<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SweebAppFront.Components.MenuButtons"
             x:Name="self">
    
    <Border x:Name="MenuButton" 
            Background="{DynamicResource Highlight}"
     >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=SetButtonRadius}"/>
        </Border.StrokeShape>

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="5">

            <Image x:Name="iconMenuButton" 
                   Source="{Binding Source={x:Reference self}, Path=IconPath}"
                   HorizontalOptions="Center" 
                   WidthRequest="{Binding Source={x:Reference self}, Path=SetIconWidth}"
                   HeightRequest="{Binding Source={x:Reference self}, Path=SetIconHeight}" 
                   VerticalOptions="Center"
            />

            <Label x:Name="textMenuButton" 
                   FontSize="{Binding Source={x:Reference self}, Path=SetTextFontSize}" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Text="{Binding Source={x:Reference self} , Path=MenuText}" 
            />
        </HorizontalStackLayout>
    </Border>
</ContentView>