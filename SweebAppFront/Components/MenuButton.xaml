<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:behaviors="clr-namespace:SweebAppFront.Behaviors"
             x:Class="SweebAppFront.Components.MenuButton"
             x:Name="self">
    
    <Border x:Name="MenuButtonBorder" 
            Background="{DynamicResource Highlight}"
     >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=SetButtonRadius}"/>
        </Border.StrokeShape>
        <Border.Behaviors>
            <toolkit:TouchBehavior
                DefaultAnimationDuration="250"
                DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                PressedOpacity="0.8"
                PressedScale="0.9"
                HoveredScale="1.05"
            />
            <behaviors:CursorBehavior Cursor="Hand"/>
        </Border.Behaviors>

        <Border.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="30" Margin="5">

            <Image x:Name="iconMenuButton" 
                   Source="{Binding Source={x:Reference self}, Path=IconPath}"
                   HorizontalOptions="Center" 
                   WidthRequest="{Binding Source={x:Reference self}, Path=SetIconWidth}"
                   HeightRequest="{Binding Source={x:Reference self}, Path=SetIconHeight}" 
                   VerticalOptions="Center"
            />

            <Label x:Name="textMenuButton" 
                   FontSize="{Binding Source={x:Reference self}, Path=SetTextFontSize}" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Text="{Binding Source={x:Reference self} , Path=MenuText}" 
            />
        </HorizontalStackLayout>
    </Border>
</ContentView>