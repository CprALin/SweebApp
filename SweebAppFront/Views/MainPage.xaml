<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SweebAppFront.Views.MainPage"
    xmlns:components="clr-namespace:SweebAppFront.Components"
    x:Name="MainRoot"
    Padding="0">

    <Grid ColumnDefinitions="*,240" RowDefinitions="*" Background="{DynamicResource Primary}">
        <components:SlidebarView Grid.Column="1"/>

        <Border Stroke="{DynamicResource Accent}" StrokeThickness="1" Padding="0" >
            <ContentView x:Name="PageHost" Grid.Column="0" Content="{Binding CurrentView}" Background="{DynamicResource Primary}"/>
        </Border>
    </Grid>
</ContentPage>
