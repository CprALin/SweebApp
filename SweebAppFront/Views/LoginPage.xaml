<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:SweebAppFront.Converters"
             x:Class="SweebAppFront.Views.LoginPage"
             Title="Login"
             BackgroundColor="{DynamicResource Accent}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid ColumnDefinitions="*,*" RowDefinitions="*">
        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
            <Image Source="working.png" HeightRequest="400" WidthRequest="400" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="100" Spacing="30" MaximumWidthRequest="800">
            <Grid RowDefinitions="*,*">
                <Label 
                     Text="Welcome to the application 👋"
                     FontSize="26"
                     FontAttributes="Bold"
                     Grid.Row="0"
                />

                <Label 
                     Text="Tell us your name, and you're good to go !"
                     FontSize="14"
                     FontAttributes="Bold"
                     Grid.Row="1"
                />
            </Grid>

            <Entry 
                Placeholder="Username"
                Text="{Binding Username}"
                ReturnType="Next"
                Completed="OnUserCompleted"
            />
            <!--
            <Entry 
                Placeholder="Email"
                Text="{Binding Email}" 
                ReturnType="Next"
                Completed="OnEmailCompleted"
            />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                Text="{Binding Password}"
                ReturnType="Done"
                Completed="OnPasswordCompleted"
            />
-->

            <Grid>
                <Grid.Behaviors>
                    <toolkit:TouchBehavior
                            DefaultAnimationDuration="250"
                            DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                            PressedOpacity="0.8"
                            PressedScale="0.9"
                            HoveredScale="1.05"
                        />  
                </Grid.Behaviors>
                
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUserCompleted"/>
                </Grid.GestureRecognizers>


                <Button
                    HeightRequest="40"
                    WidthRequest="150"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>

                <Grid>
                        <Label
                            Text="Open app"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>

                        <ActivityIndicator
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"/>
                </Grid>

            </Grid>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
            />
        </VerticalStackLayout>
    </Grid>
</ContentPage>