<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SweebAppFront.Views.LiveRequestsView">
    <ContentView.Resources>
        <Style x:Key="TableHeader" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        
        <Style x:Key="TableContent" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style x:Key="TableLines" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="1"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="HeightRequest" Value="30"/>
        </Style>

        <Style x:Key="TableContentLines" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="1"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="HeightRequest" Value="10"/>
        </Style>

        <Style x:Key="TableBottomLines" TargetType="BoxView">
            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}"/>
            <Setter Property="HeightRequest" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="80,*" ColumnDefinitions="*">
       <Label 
          Text="Live Requests"
          HorizontalOptions="Start"
          VerticalOptions="Center"
          Margin="20"
          FontSize="30"
          FontAttributes="Bold"
          Grid.Row="0"
       />

        <Grid RowDefinitions="40,*" Margin="10" Grid.Row="1">
            
            <Border Grid.Row="0" Stroke="{DynamicResource Accent}" Margin="15,0,15,0" StrokeShape="RoundRectangle 15">
                <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*,1,*" RowDefinitions="*" BackgroundColor="{DynamicResource Highlight}" >
                    <Label Style="{StaticResource TableHeader}" Text="Method" Grid.Column="0"/>
                    <BoxView Style="{StaticResource TableLines}" Grid.Column="1"/>
                    <Label Style="{StaticResource TableHeader}" Text="Protocol" Grid.Column="2"/>
                    <BoxView Style="{StaticResource TableLines}" Grid.Column="3"/>
                    <Label Style="{StaticResource TableHeader}" Text="Url" Grid.Column="4"/>
                    <BoxView Style="{StaticResource TableLines}" Grid.Column="5"/>
                    <Label Style="{StaticResource TableHeader}" Text="Host" Grid.Column="6"/>
                    <BoxView Style="{StaticResource TableLines}" Grid.Column="7"/>
                    <Label Style="{StaticResource TableHeader}" Text="Port" Grid.Column="8"/>
                    <BoxView Style="{StaticResource TableLines}" Grid.Column="9"/>
                    <Label Style="{StaticResource TableHeader}" Text="Threat" Grid.Column="10"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="25,0,25,0" BackgroundColor="{DynamicResource Highlight}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,5,5"/>
                </Border.StrokeShape>
                <ScrollView Margin="5">
                    <CollectionView ItemsSource="{Binding LiveTraffic}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*,1,*" ColumnSpacing="15">
                                        <Label Style="{StaticResource TableContent}" Text="{Binding Method}" Grid.Column="0"/>
                                        <BoxView Style="{StaticResource TableContentLines}" Grid.Column="1"/>
                                        <Label Style="{StaticResource TableContent}" Text="{Binding Protocol}" Grid.Column="2"/>
                                        <BoxView Style="{StaticResource TableContentLines}" Grid.Column="3"/>
                                        <Label Style="{StaticResource TableContent}" Text="{Binding Url}" Grid.Column="4"/>
                                        <BoxView Style="{StaticResource TableContentLines}" Grid.Column="5"/>
                                        <Label Style="{StaticResource TableContent}" Text="{Binding Host}" Grid.Column="6"/>
                                        <BoxView Style="{StaticResource TableContentLines}" Grid.Column="7"/>
                                        <Label Style="{StaticResource TableContent}" Text="{Binding Port}" Grid.Column="8"/>
                                        <BoxView Style="{StaticResource TableContentLines}" Grid.Column="9"/>
                                        <Label Style="{StaticResource TableContent}" Text="{Binding IsThreat}" Grid.Column="10"/>
                                    </Grid>
                                    <BoxView Style="{StaticResource TableBottomLines}"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentView>
